# CircuitAgent v0.1 — Environment Configuration

# LLM API credentials (OpenAI-compatible)
# Default: DeepSeek API
CIRCUITAGENT_API_KEY=sk-your-api-key-here
CIRCUITAGENT_BASE_URL=https://api.deepseek.com
CIRCUITAGENT_MODEL=deepseek-chat

# Or use OpenAI:
# CIRCUITAGENT_API_KEY=sk-your-openai-key
# CIRCUITAGENT_BASE_URL=https://api.openai.com/v1
# CIRCUITAGENT_MODEL=gpt-4o
